generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
}

enum ProjectStatus {
  completed
  in_progress @map("in-progress")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(admin)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String
  image       String?
  tags        String[]      @default([])
  categories  String[]      @default([])
  year        String
  status      ProjectStatus @default(completed)
  github      String?
  demo        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  slug        String? @unique
  summary     String?
  fileId      String?
  file        UploadedFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  published   Boolean @default(true)
  featured    Boolean @default(false)
  sortOrder   Int @default(0)
  startDate   DateTime?
  endDate     DateTime?

  @@index([published, featured, sortOrder])
  @@index([fileId])
  @@index([image, published])
  @@index([status])
  @@index([categories])
}

model DailyVisit {
  id        String   @id @default(cuid())
  date      DateTime @unique
  count     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum FileOwnerType {
  CERTIFICATE
  PROJECT
  GENERAL
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UploadedFile {
  id        String        @id @default(cuid())
  ownerType FileOwnerType @default(GENERAL)
  ownerId   String?
  filename  String
  key       String        @unique
  mimeType  String
  size      Int
  url       String
  provider  String        @default("supabase")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  certificates Certificate[]
  projects     Project[]
}

model Certificate {
  id           String        @id @default(cuid())
  title        String
  issuer       String
  issueDate    DateTime?
  credentialId String?
  credentialUrl String?
  description  String?
  imageUrl     String?
  fileId       String?
  file         UploadedFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  tags         String[]      @default([])
  published    Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([published, sortOrder])
  @@index([fileId])
  @@index([imageUrl, published])
}

model StorageCleanupJob {
  id            String   @id @default(cuid())
  key           String   @unique
  createdAt     DateTime @default(now())
  nextAttemptAt DateTime
  attempts      Int      @default(0)

  @@index([nextAttemptAt])
}
