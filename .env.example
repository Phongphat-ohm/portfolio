DATABASE_URL="postgresql://portfolio_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full"
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full"
DATABASE_POOL_MAX="3"

AUTH_SECRET="replace-with-at-least-32-random-characters-and-keep-existing-value-during-cutover"
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ON_SERVER_ONLY"
SUPABASE_STORAGE_BUCKET="portfolio-files"
MAINTENANCE_READ_ONLY="false"

# Migration/backup tools only. Do not expose these to the browser.
SOURCE_DATABASE_URL="postgresql://SOURCE_READ_ONLY_USER:ENCODED_PASSWORD@SOURCE_HOST:5432/portfolio"
TARGET_DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full"
RUNTIME_DATABASE_PASSWORD="replace-with-a-unique-random-password-of-at-least-24-characters"
CONFIRM_TARGET_IMPORT="false"
CONFIRM_STORAGE_WRITE="false"
BACKUP_ROOT="C:/secure-offsite-backups/portfolio"
BACKUP_DATABASE_URL="postgresql://BACKUP_USER:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full"

# Keep legacy source access until migration and rollback window are complete.
SFTPGO_BASE_URL="https://sftpgo.example.com"
