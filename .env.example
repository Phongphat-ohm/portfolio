# Database (PostgreSQL server ของตัวเอง)
DATABASE_URL=""

# Redis (ใช้สำหรับนับผู้เข้าชมแบบเรียลไทม์) - path ท้ายต้องเป็นตัวเลข (database index) เช่น /0
REDIS_URL=""

# Auth
JWT_SECRET=""

ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# S3-compatible object storage (SeaweedFS S3 API / AWS / MinIO / Ceph ใช้ได้หมด)
S3_ENDPOINT=""
S3_PORT=""
S3_USE_SSL=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE=""

# ขนาดไฟล์ (bytes): ≤ SMALL_UPLOAD_LIMIT อัปโหลดผ่าน API proxy, มากกว่านั้นใช้ presigned URL
S3_SMALL_UPLOAD_LIMIT="5242880"  # 5MB
S3_MAX_UPLOAD_SIZE="52428800"    # 50MB
S3_PRESIGN_EXPIRES="900"         # วินาที (15 นาที)